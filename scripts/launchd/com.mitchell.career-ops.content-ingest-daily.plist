<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mitchell.career-ops.content-ingest-daily</string>

    <!-- PR-B 2026-05-27 — Daily content ingest at 03:00 PT.
         Populates data/dispatch/{convos,articles}.json from Tier 1 sources
         (Grok-X + Perplexity-Reddit + HN + GitHub trending). Read by
         heartbeat-dispatch.mjs themed-weekday rotation at 09:00 PT same day.
         Per Q12 locked per-source cadence. Typical run cost: $0.15-$0.40. -->

    <key>ProgramArguments</key>
    <array>
        <string>/Users/mitchellwilliams/.nvm/versions/node/v24.14.0/bin/node</string>
        <string>/Users/mitchellwilliams/Documents/career-ops/scripts/agents/content-ingest.mjs</string>
        <string>--mode=daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mitchellwilliams/Documents/career-ops</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- Tahoe TCC: logs MUST live outside ~/Documents/. Pattern F. -->
    <key>StandardOutPath</key>
    <string>/Users/mitchellwilliams/Library/Logs/career-ops/content-ingest-daily.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/mitchellwilliams/Library/Logs/career-ops/content-ingest-daily.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/mitchellwilliams/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/mitchellwilliams</string>
    </dict>

    <key>AbandonProcessGroup</key>
    <true/>
</dict>
</plist>
