<mjml>
  <mj-head>
    <mj-title>Career-Ops Daily Heartbeat — {{date}}</mj-title>
    <mj-preview>{{preheaderText}}</mj-preview>
    <mj-attributes>
      <!-- Phase E2 (2026-05-19) — DARK-FIRST body with light @media overlay.
           Closes the Phase C deferral. Real-council ratified 7/7 universal
           in Phase E1 — see .claude/audit/email-review/council-divergence-
           analysis.md finding-014. The BRAND tokens in
           scripts/heartbeat.mjs + scripts/heartbeat-evening.mjs now source
           from lib/heartbeat-tokens.json email.dark.*. The @media
           (prefers-color-scheme: light) block below flips on light-opt-in
           clients (Apple Mail / Gmail Web / Outlook 365) so the prior
           light-mode appearance is preserved for users who have opted out
           of dark mode at the OS level.
           Body: #e4e4e7 on #06070d = 13.3:1 (AAA). -->
      <mj-text
        font-family="'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif"
        font-size="13px"
        line-height="1.45"
        color="#e4e4e7"
      />
      <mj-button
        font-family="'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif"
        font-size="12px"
        font-weight="600"
        letter-spacing="0.01em"
        border-radius="8px"
        inner-padding="8px 16px"
      />
      <mj-section padding="0 0 4px 0" />
    </mj-attributes>

    <mj-style>
      /* ── Light-mode overlay (Phase E2, 2026-05-19) ───────────────────────
         Dark-first is the default; this block flips on clients where the
         user has opted into light mode at the OS level (prefers-color-scheme:
         light). Token sources: lib/heartbeat-tokens.json email.light.*.
         Apple Mail, Gmail Web, Outlook 365 honor prefers-color-scheme.
         The meta name="supported-color-schemes" + meta name="color-scheme"
         pair below is still load-bearing — it tells Gmail iOS not to apply
         its own auto-inversion on top of the developer-supplied palette. */
      @media (prefers-color-scheme: light) {
        body, .body-bg   { background: #f8f9fb !important; color: #374151 !important; }
        .card            { background: #ffffff !important; border-color: #e5e7eb !important; color: #374151 !important; }
        .text-strong     { color: #111827 !important; }
        .text-muted      { color: #475569 !important; }
        .text-subtle     { color: #6b7280 !important; }
        .border          { border-color: #e5e7eb !important; }
        .accent          { color: #15803d !important; }
        table            { border-color: #e5e7eb !important; background: #ffffff !important; }
        thead, th        { background: #f1f5f9 !important; color: #475569 !important; border-color: #e5e7eb !important; }
        td               { color: #374151 !important; border-color: #e5e7eb !important; }
        blockquote       { background: #dcfce7 !important; color: #111827 !important; border-left-color: #15803d !important; }
        code             { background: #f1f5f9 !important; color: #15803d !important; }
        hr               { background: linear-gradient(90deg, transparent 0%, #e5e7eb 50%, transparent 100%) !important; }
        a                { color: #15803d !important; }
        .header-banner   {
          background: linear-gradient(135deg, rgba(22,163,74,0.10) 0%, rgba(22,163,74,0.04) 50%, #ffffff 100%) !important;
          border: 1px solid #e5e7eb !important; color: #111827 !important;
        }
        .cta-button      { background: #ffffff !important; color: #15803d !important; }
        .score-pill-green { background: #dcfce7 !important; color: #15803d !important; border-color: #86efac !important; }
        .score-pill-amber { background: #f4ede1 !important; color: #8a6840 !important; }
        .score-pill-red   { background: #fee2e2 !important; color: #991b1b !important; }
        .focus-callout, .focus-callout * { color: #111827 !important; }
        .focus-callout   { background: #dcfce7 !important; border-left-color: #15803d !important; }
        /* Light-mode override for the inline-styled "card" containers
           emitted by helper functions in scripts/heartbeat.mjs. The
           `* { color: }` descendant rule overrides inline `color:` props
           on child <div>/<span>/<strong> nodes — necessary because each
           helper now hardcodes dark text colors for dark mode (Phase E2). */
        .tonight-card, .tonight-card * { color: #111827 !important; }
        .tonight-card    { background: #dcfce7 !important; border-color: #86efac !important; }
        .due-today-card  { background: #ffffff !important; border-color: #e5e7eb !important; }
        .due-today-card * { color: #374151 !important; }
        .signal-pulse-card, .signal-pulse-card * { color: #374151 !important; }
        .signal-pulse-card { background: #ffffff !important; border-color: #e5e7eb !important; }
        .next-moves-card { background: #dcfce7 !important; }
        .next-moves-card * { color: #374151 !important; }
        .next-move-row, .next-move-row * { color: #374151 !important; }
        .next-move-row { background: #ffffff !important; border-color: #e5e7eb !important; }
        /* .runway-card rules removed 2026-05-25 alongside the broader
           runway-coupling sweep — no element emits the class any longer. */
        .system-banner   { background: #ffffff !important; border-color: #e5e7eb !important; }
        .system-banner * { color: #374151 !important; }
      }
    </mj-style>

    <mj-raw>
      <!-- Phase E2 dark-first — both meta tags REQUIRED to opt out of
           Gmail iOS auto-inversion. supported-color-schemes tells Gmail iOS
           that the developer-supplied palette IS the design intent, so
           Gmail's auto-inversion logic stays off. With both declared, every
           color-scheme-aware client renders the dark default + light @media
           overlay as intended. -->
      <meta name="color-scheme" content="light dark">
      <meta name="supported-color-schemes" content="light dark">
    </mj-raw>
  </mj-head>

  <mj-body background-color="#06070d" css-class="body-bg">

    <!-- ═══════════════════════════════════════════════════════════════════
         HERO — saturated #16a34a (accent) reads correctly on both the
         dark body bg (#06070d, default) and the light @media overlay
         (#f8f9fb). Kept at #16a34a because (a) evening script string-
         replaces this exact hex to swap in the slate-blue evening hero
         (#5a76a6), and (b) a single saturated band on a dark body becomes
         the dominant focal point — exactly the visual hierarchy the Phase
         E1 real-council wanted for the 09:00 PT email.
         mj-button = bulletproof VML+CSS hybrid (Outlook 2016+ compatible).
         ═══════════════════════════════════════════════════════════════════ -->
    <mj-section
      background-color="#16a34a"
      css-class="header-banner"
      border-radius="10px"
      padding="16px 20px"
    >
      <mj-column vertical-align="middle">
        <mj-text color="rgba(255,255,255,0.85)" font-size="10px" letter-spacing="0.15em" text-transform="uppercase" font-weight="700" padding-bottom="2px"><span role="img" aria-label="Lightning bolt: career ops">⚡</span> Career-Ops</mj-text>
        <mj-text color="#ffffff" font-size="21px" font-weight="700" letter-spacing="-0.01em" font-family="'JetBrains Mono', 'SF Mono', ui-monospace, monospace" padding="0">{{date}}</mj-text>
      </mj-column>
      <mj-column vertical-align="middle" width="150px">
        <mj-button href="{{dashboardUrl}}" background-color="#ffffff" color="#15803d" border-radius="8px" font-size="12px" font-weight="600" css-class="cta-button" align="right" inner-padding="8px 14px">Dashboard →</mj-button>
      </mj-column>
    </mj-section>

    <!-- ═══════════════════════════════════════════════════════════════════
         §1 TONIGHT'S APPLY + §2 DUE TODAY + §3 DELTAS + §4 TODAY'S FOCUS
         All action/context sections in one mj-section to minimize MJML
         table overhead. Section labels are inline (no separate mj-section).
         ═══════════════════════════════════════════════════════════════════ -->
    <mj-section padding="8px 0 4px 0">
      <mj-column>
        <mj-text padding="0">{{actionSectionsHtml}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- ═══════════════════════════════════════════════════════════════════
         §5 WEEKLY GROWTH (TPgM) — Monday only; empty string on other days.
         §6a PIPELINE PULSE KPI tiles — 3 user-facing stats only.
         Consolidated into one section to cut MJML overhead.
         ═══════════════════════════════════════════════════════════════════ -->
    <mj-section padding="4px 0 4px 0">
      <mj-column>
        <mj-text padding="0">{{tpgmHeartbeatSectionHtml}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- KPI tiles — 3 columns (Queue ≥4.0 / Eval'd today / Total tracked).
         Dark defaults (Phase E2); light @media block flips on light-opt-in clients. -->
    <mj-section padding="4px 0 12px 0">
      <mj-column border="1px solid #232737" border-radius="8px" background-color="#11131c" padding="10px 12px" css-class="card border">
        <mj-text color="#9a9aa6" font-size="10px" font-weight="700" letter-spacing="0.08em" text-transform="uppercase" align="center" padding-bottom="3px" css-class="text-muted">Ready to Apply</mj-text>
        <mj-text color="#4ade80" font-size="21px" font-weight="700" align="center" font-family="'JetBrains Mono', 'SF Mono', ui-monospace, monospace" padding="0" css-class="text-strong accent">{{kpiQueueCount}}</mj-text>
      </mj-column>
      <mj-column border="1px solid #232737" border-radius="8px" background-color="#11131c" padding="10px 12px" css-class="card border">
        <mj-text color="#9a9aa6" font-size="10px" font-weight="700" letter-spacing="0.08em" text-transform="uppercase" align="center" padding-bottom="3px" css-class="text-muted">Evaluated Today</mj-text>
        <mj-text color="#94a3b8" font-size="21px" font-weight="700" align="center" font-family="'JetBrains Mono', 'SF Mono', ui-monospace, monospace" padding="0" css-class="text-strong">{{kpiEvaluatedToday}}</mj-text>
      </mj-column>
      <mj-column border="1px solid #232737" border-radius="8px" background-color="#11131c" padding="10px 12px" css-class="card border">
        <mj-text color="#9a9aa6" font-size="10px" font-weight="700" letter-spacing="0.08em" text-transform="uppercase" align="center" padding-bottom="3px" css-class="text-muted">Total Tracked</mj-text>
        <mj-text color="#e4e4e7" font-size="21px" font-weight="700" align="center" font-family="'JetBrains Mono', 'SF Mono', ui-monospace, monospace" padding="0" css-class="text-strong">{{kpiTrackedCount}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- §6b Context banners — system banner + discard pattern (runway-alert
         block was retired 2026-05-25; the slot survives for the remaining
         banners). -->
    <mj-section padding="0 0 8px 0">
      <mj-column>
        <mj-text padding="0">{{contextSectionsHtml}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- ═══════════════════════════════════════════════════════════════════
         §7 MAIN CONTENT — markdown body rendered via renderContentHtml().
         Morning (Phase B): What's New Overnight → Apply-Now Queue → Outreach → stat summary.
         System-health sections moved to heartbeat-evening.mjs (18:00 PT).
         Wave D changes (H5–H7, T2#7) applied inside renderContentHtml().
         ═══════════════════════════════════════════════════════════════════ -->
    <mj-section padding="0 0 8px 0">
      <mj-column>
        <mj-text padding="0">{{contentHtml}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- ═══════════════════════════════════════════════════════════════════
         FOOTER — small, quiet. Matches dashboard footer visual weight.
         Dark defaults (Phase E2); light @media block flips on light-opt-in clients.
         ═══════════════════════════════════════════════════════════════════ -->
    <mj-section padding="10px 0 6px 0" border-top="1px solid #232737" css-class="border">
      <mj-column>
        <mj-text align="center" font-size="11px" color="#9a9aa6" css-class="text-subtle" line-height="1.4">
          <a href="{{dashboardUrl}}" style="color:#86efac;text-decoration:none" class="accent">dashboard</a> · 09:00 PT
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
