{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careers-ops.com/schemas/why-statement",
  "title": "Why Statement Artifact",
  "description": "Schema-typed why-statement artifact emitted to apply-pack/<slug>/why-statement.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "agent_name": {
      "type": "string",
      "const": "why-statement"
    },
    "slug": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "company": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "statement": {
      "type": "string",
      "description": "The core why-statement prose paragraph"
    },
    "anchors": {
      "type": "array",
      "description": "Evidence anchors grounding the statement in corpus/JD",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "corpus_ref",
          "claim"
        ],
        "properties": {
          "corpus_ref": {
            "type": "string",
            "description": "Source reference, e.g. 'cv.md:142' or 'article-digest.md'"
          },
          "claim": {
            "type": "string",
            "description": "The specific claim being grounded by this anchor"
          }
        }
      }
    },
    "short_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "1-2 sentence condensed version for forms with tight char limits"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "agent_name",
    "slug",
    "generated_at",
    "statement",
    "anchors"
  ]
}
