  "typography": {
    "$comment": "Type ramp shared across surfaces. h2_email vs h2_dashboard captures the council's Decision-C nuance: email H2 = 16px (right ratio against 14px body in mobile WebKit), dashboard H2 = 16-18px depending on context (the dashboard uses both).",
    "fontFamily": {
      "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
      "mono": "'JetBrains Mono', 'IBM Plex Mono', 'SF Mono', SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "size": {
      "h1": "22px",
      "h2_email": "16px",
      "_note_h2_email": "intentionally smaller than h2_dashboard_large (18px); compensates for mobile WebKit text autosize that scales email font-size ~0.5-1px larger than desktop browser. See docs/adr/0007-email-h2-divergence.md. DO NOT 'fix' this back to 18px without consulting the ADR.",
      "h2_dashboard": "16px",
      "h2_dashboard_large": "18px",
      "h3": "13px",
      "h4": "15px",
      "body": "14px",
      "small": "13px",
      "caption": "12px",
      "meta": "11px",
      "badge": "10px"
    },
