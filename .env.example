# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── Gemini Integration (Issue #344) ─────────────────────────────────────────
# Required for: node gemini-eval.mjs "JD text here"
# Free API key: https://aistudio.google.com/apikey
# Free tier: 15 RPM / 1M tokens/day with gemini-2.0-flash (no billing needed)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Override default Gemini model ───────────────────────────────────
# Default: gemini-2.0-flash (free-tier, fast)
# Alternatives: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-thinking-exp
# GEMINI_MODEL=gemini-2.0-flash

# ── Heartbeat evening digest gate (Phase D, 2026-05-19) ─────────────────────
# Set to false to kill the evening email without uninstalling the launchd plist.
# Default when unset: true (enabled). --preview still works when set to false.
HEARTBEAT_EVENING_ENABLED=true

# ── G38 detector portfolio (2026-05-24) ─────────────────────────────────────
# Per-detector + global disable flags for the AI-detection layer
# (lib/ai-detection-gate.mjs). Preserves API keys for future re-enabling.
#
# Why this exists: data/detector-recalibration-audit-2026-05-23.md confirmed
# all 3 detectors return prob=1.0 on BOTH Mitchell's writing AND AI decoys —
# structural saturation, not adapter bugs. Layer 2 voice-rules carries the
# polish-loop gate per Closure 09 Part 5 fix. Paying for API calls the L1
# gate explicitly ignores is waste.
#
# Mitchell's locked 2026-05-24 decision: KEEP GPTZero (industry-standard
# for recruiter screening per SHRM 2026 + GPTZero's own "#1 AI Detector
# for Recruiters" positioning), PAUSE Originality (SEO/publishing focus,
# not recruiting) + Pangram (newer, less ATS-integrated). Polish-loop's new
# detection-revision sub-loop (lib/polish-loop.mjs G38 2026-05-24 block)
# iterates against GPTZero only with threshold <0.5 = "human-likely".
#
# Set value to "1" to disable. Re-enable individually as vendors improve.
# AI_DETECTION_DISABLED=1     # global kill — disables all 3 regardless of per-detector flags
# GPTZERO_DISABLED=1          # disable GPTZero only (current state: ENABLED)
ORIGINALITY_DISABLED=1        # disabled per 2026-05-24 G38 portfolio decision
PANGRAM_DISABLED=1            # disabled per 2026-05-24 G38 portfolio decision

# ── Batch cancellation timeout (P0.7, 2026-05-20) ──────────────────────────
# Graceful-cancel window for an in-flight batch before SIGKILL fires. Must be
# >= the AbortSignal.timeout in lib/anthropic-batch-helper.mjs (currently
# 120000ms / 120s). 125000ms = 5s safety margin over that.
# Default when unset: 125000.
# See AGENTS.md "Batch lifecycle" section + data/p07-batch-actions-ux-research-
# 2026-05-20.md for the convergence rationale.
BATCH_CANCEL_TIMEOUT_MS=125000

# ── Cost-stratified cancel warning threshold (P0.7 v2, 2026-05-20) ─────────
# Spend amount above which the "Cancel batch" button opens a single-confirm
# dialog ("$X spent on this batch — cancel anyway?") before SIGTERM. Below
# this, cancel is instant + uses the disabled "Stopping…" button state.
# Default when unset: 10 (USD). v2 work — see data/decisions-pending-2026-05-
# 20.md § "P0.7 v2 — cost-stratified cancel UX" for the 30-line sketch.
BATCH_CANCEL_WARN_THRESHOLD_USD=10

# ── Dashboard build-weight gate (P2.16, 2026-05-20) ─────────────────────────
# Soft and hard ceilings on the minified dashboard/index.html size. Catches
# the inline-payload-bloat bug class (~/.claude/knowledge/brain/bug-class-
# catalog.md § inline-payload-bloat) — when contacts / pill-data / wave-cb
# payloads accidentally get baked into the outer HTML instead of served from
# /data, the dashboard balloons fast. Soft over WARN: console.warn + continue.
# Hard over FAIL: process.exit(1).
# Defaults when unset: 12 MB warn / 15 MB fail (current build ~7.4 MB).
# Bypass entirely with DASHBOARD_SKIP_WEIGHT_GATE=1 (emergency only).
DASHBOARD_WEIGHT_WARN_BYTES=12582912
DASHBOARD_WEIGHT_FAIL_BYTES=15728640

# ── Polish convergence-runaway caps (2026-05-24) ────────────────────────────
# Per-artifact hard cap on TOTAL polish rounds across outer attempts. Pre-fix,
# lib/polish-loop.mjs could run maxRounds=6 INNER × outerRetries=3 = 18 rounds
# when the adversarial gate kept hedging passes:false with zero blocking
# findings. Canonical incident — 2026-05-24 PID 45655 on row #48 (Anthropic
# Engineering Editorial Lead): 82 min wall clock, $8.27 spent, never
# converged, process killed without writing polish-orchestrator-summary.json.
#
# When the cap is hit before convergence, the artifact is marked
# abandoned: true + abandon_reason: 'max-rounds-exceeded' and the loop exits.
# Default 6 (matches the prior per-outer cap, but applied across the full
# chain → at most ~$3-4 spend per artifact under typical Round 1-5 cost
# profile). Safety clamp [1, 30]. Override via CLI --max-rounds <N>.
POLISH_MAX_ROUNDS=6

# Soft cost-warn threshold below the hard POLISH_COST_CAP_USD=500. Two
# behaviors:
#   - Per-artifact (lib/polish-loop.mjs): NDJSON WARN line to stderr every
#     round after total artifact cost crosses this threshold. Does NOT block
#     the running artifact.
#   - Per-pack (scripts/agents/apply-pack-polish.mjs): force-abandons any
#     artifacts that have not started yet, with abandon_reason: 'cost-warn-
#     threshold'. Already-running artifacts complete normally.
# Default $5. Override via CLI --cost-warn-usd <N>.
POLISH_COST_WARN_USD=5

# ── Other integrations (add your own below) ──────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_key_here   # For Claude-based workflows
# OPENAI_API_KEY=your_openai_key_here          # Future OpenAI integration

# ── AI Detection Gate (lib/ai-detection-gate.mjs) ───────────────────────────
# Three-detector ensemble: GPTZero + Originality.AI + Pangram (third detector,
# selected by council + dealbreaker adjudication 2026-05-19).
# If a key is missing, that detector is skipped (not blocking).
#
# GPTZero: https://gptzero.me/api — ~$0.01/call
# GPTZERO_API_KEY=
#
# Originality.AI: https://originality.ai/api — ~$0.01/call
# ORIGINALITY_API_KEY=
#
# Pangram: https://www.pangram.com/solutions/api — ~$0.02/call, $20/mo base
# UChicago BFI study (Aug 2025): lowest FPR of any tested detector (0.004%)
# Dealbreaker-selected over Sapling (28-95% FPR) and Copyleaks (5-6% FPR)
# PANGRAM_API_KEY=

# ── Drive integration (Cluster E3, 2026-05-21) ──────────────────────────────
# OAuth client created in Google Cloud Console → APIs & Services → Credentials.
# Required scope: https://www.googleapis.com/auth/drive.file (drive.file is the
# narrowest scope that supports the apply-pack push/pull lifecycle).
# Run scripts/setup-drive-auth.mjs to populate GOOGLE_DRIVE_REFRESH_TOKEN
# + flip DRIVE_SYNC_ENABLED=true.
DRIVE_SYNC_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=your_oauth_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=

# ── regression-guard agent (2026-05-23) ─────────────────────────────────────
# Aggressive regression detection across 8 types. Daily 06:00 PT scheduled
# at v1.0 — Q3 lib-split sprint (2026-05-23 evening) moved to WEEKLY MONDAYS
# for the 4-week calibration window (2026-05-25 → 2026-06-22), then flip back
# to daily. Loaded-but-DISABLED day-1 awaiting trial-run review.
# Spec: /Users/mitchellwilliams/.claude/agents/runs/dealbreaker-final-20260523-132911-regression-agent-delta.md
# Mitchell's locked overrides of the dealbreaker numbers: NO hard per-call
# sub-cap, SOFT $5/call warning only. Cap recalibrated 2026-05-26:
# deterministic scans cost $0; deep forensics (--synthesize) cost ~$0.50-2;
# $10 allows 5+ deep runs before guard fires — meaningful guardrail vs $20
# which never fires at all.
REGRESSION_GUARD_ENABLED=true
REGRESSION_GUARD_AUTO_ACTION=false
REGRESSION_GUARD_DAILY_USD=10
REGRESSION_GUARD_PER_CALL_WARN_USD=5
REGRESSION_GUARD_CANARY_FAIL_SHUT=true
REGRESSION_GUARD_SILENT_PERIOD_DAYS_BY_TYPE=code:7,closure:7,memory:7,data:7,ui:7,pipeline:14,behavioral:14,performance:14
REGRESSION_GUARD_BASELINE_EXPIRY_DAYS=30
REGRESSION_GUARD_SELF_THROTTLE_THRESHOLD=8
# Feature flag for Vector 2 transcript baseline — keep OFF for first 30 days,
# flip after baseline-build review per dealbreaker § Audit Item 3.
REGRESSION_GUARD_TRANSCRIPT_BASELINE_ENABLED=false
REGRESSION_GUARD_CROSS_SESSION_CADENCE=daily
# Gemini 3.1 Pro is still in preview as of May 2026; GA migration may require
# code update per known-limitations. Defaults to preview.
REGRESSION_GUARD_GEMINI_TIER=preview
# Separate budget for --deep forensic mode (Opus 4.7 + Gemini 3.1 Pro + Sonnet 4.6).
# Q2 sprint 2026-05-23 live-validated the v1.1 multi-deep + Sonnet 4.6 path
# against real sessions at $0.0012 total spend (well under cap). The Gemini
# 3.1 Pro Preview model returned HTTP 404 from the v1beta endpoint — fallback
# to Sonnet now fires automatically on 404-model-not-found in addition to
# 5xx/timeout. See .claude/audit/regression-guard-tune-2026-05-23/deep-validation.md.
REGRESSION_GUARD_DEEP_BUDGET_USD=10

# ── popout-grounding (2026-05-23) ───────────────────────────────────────────
# Rollback gate for lib/ground-prompt.mjs — the RAG primitive that grounds
# the 4 drawer popouts (alignment / interview-likelihood / hm-chance /
# team-health) in Mitchell's personality corpus + profile.
#
# Default = "1" (grounded). Flip to "0" for instant revert to v0 generic
# prompt shapes — no code change needed, takes effect on next popout call.
#
# Locked decision #6 (popout-grounding /feedback 2026-05-23):
# rollback via env-flag is the required safety lock.
STRATEGY_CEILING_GROUNDED_MODE=1
# Opt-in Q3 Layer-3 LLM voice classifier on cache writes. Default off so
# popouts don't pay the ~$0.005 Haiku classifier call without explicit
# consent. Flip to "1" to attach voice_score telemetry to written cache
# entries (best-effort; classifier failures never block result).
STRATEGY_CEILING_VOICE_CLASSIFIER=0

# ── PR-02 personality-corpus grounding (2026-05-25) ────────────────────────
# Master kill-switch for the lean personality + profile corpus grounding
# injected into 9 content agents (cv-tailor, cover-letter, why-statement,
# form-fields, linkedin-dm, impact-doc, references, referrals,
# network-draft-intro). When set to "false", each agent runs with its
# original SYSTEM_PROMPT only — no corpus injection.
#
# Default = unset (effectively ON). Set to "false" for instant revert.
# Reload services after flip: launchctl kickstart -k gui/$(id -u)/com.mitchell.career-ops.dashboard-server
#
# Cross-fork-leak compliance:
#   - Anthropic vendors (anthropic:*)  → full personality + profile corpus inline
#   - Non-Anthropic (openai/google/perplexity/xai) → summary-only references,
#     never inline corpus content (hash_only mode).
#PERSONALITY_GROUNDING_ALL=true

# Per-agent overrides. Set to "false" to disable grounding for a specific
# agent while leaving others intact. Useful for surgical rollback if one
# agent's voice fidelity regresses post-PR-02.
#PERSONALITY_GROUNDING_CV_TAILOR=true
#PERSONALITY_GROUNDING_COVER_LETTER=true
#PERSONALITY_GROUNDING_WHY_STATEMENT=true
#PERSONALITY_GROUNDING_FORM_FIELDS=true
#PERSONALITY_GROUNDING_LINKEDIN_DM=true
#PERSONALITY_GROUNDING_IMPACT_DOC=true
#PERSONALITY_GROUNDING_REFERENCES=true
#PERSONALITY_GROUNDING_REFERRALS=true
#PERSONALITY_GROUNDING_NETWORK_DRAFT_INTRO=true

# ── bug-resolver (2026-05-23; MAX QUALITY routing 2026-05-25) ───────────────
# 7-phase LLM pipeline (post 2026-05-25 redistribution):
#   audit (Gemini 2.5 Pro) → research (Gemini 2.5 Pro) → adjudicate (Grok-4)
#   → action_plan (Grok-4) → implement (GPT-5.5 Pro) → verify (Gemini 3 Flash)
#   → harden (Gemini 3 Flash).
# Plist: com.mitchell.career-ops.bug-resolver — Mon/Thu 02:00 PT.
# LOADED-BUT-DISABLED day-1 — enable after reviewing trial run decision doc.
# Kill switch: launchctl setenv BUG_RESOLVER_ENABLED false
BUG_RESOLVER_ENABLED=true
# Daily spend ceiling. Recalibrated 2026-05-26: observed spend ~$0.16-0.80/run
# (0-5 bugs audited; most NEEDS_HUMAN without LLM cost). $25 = ~5x realistic
# max; $150 was never approached and provided no safety signal.
BUG_RESOLVER_DAILY_USD=25
# Per-bug spend ceiling. Recalibrated 2026-05-26: Gemini 2.5 Pro audit
# + Grok-4 adjudicate + GPT-5 implement + Gemini Flash verify/harden ≈ $0.50-2
# per fully-resolved bug. $10 = 5x observed max; $50 was never approached.
BUG_RESOLVER_PER_BUG_CAP=10
# Max bugs processed per launchd run (sorted CRIT → HIGH → MED → LOW).
BUG_RESOLVER_MAX_BUGS_PER_RUN=5
# Family-level kill switches — set to "true" to disable ALL models in a vendor.
# Auto circuit-breaker fires per-model after 3 consecutive 5xx/timeout failures
# (Flash failure does NOT disable Pro — they have separate counters).
BUG_RESOLVER_VENDOR_DISABLED_GEMINI=false
BUG_RESOLVER_VENDOR_DISABLED_GROK4=false
BUG_RESOLVER_VENDOR_DISABLED_GPT5=false
# Per-model kill switches — finer override, set "true" to disable ONE model
# while leaving siblings active. Useful when only one model has issues (e.g.,
# Gemini-3-flash regression while 2.5-pro is fine). Naming convention:
# BUG_RESOLVER_MODEL_DISABLED_<MODEL_SLUG> where slug is the model id
# uppercased with `.`/`-` mapped to `_`.
# BUG_RESOLVER_MODEL_DISABLED_GEMINI_2_5_PRO=false
# BUG_RESOLVER_MODEL_DISABLED_GEMINI_3_FLASH=false
# BUG_RESOLVER_MODEL_DISABLED_GROK_4=false
# BUG_RESOLVER_MODEL_DISABLED_GPT_5_5_PRO=false

# ── career-ops-health agent (2026-05-25) ────────────────────────────────────
# Comprehensive production-health agent. Closes the gap between
# /system-maintainer (SRE hygiene) and regression-guard (code/data drift)
# by checking the live production-health surface:
#   1  deploy validation (endpoint latency, dashboard build, error rate)
#   2  data freshness (apply-now, applications, heartbeat archive, panels)
#   3  OAuth + credentials (env vars present, LinkedIn cookies, Drive token)
#   4  third-party quotas (Anthropic / Gemini / GPTZero / regression / bug-resolver)
#   5  scheduled heartbeats (launchctl list, exit codes, flapping, log volume)
#   6  cost drift (total daily LLM spend banded GREEN/YELLOW/ORANGE/RED)
# Plus a Sonnet 4.6 synthesis pass cross-correlating findings into narratives.
#
# Plist: com.mitchell.career-ops.career-ops-health — daily 06:30 PT.
# LOADED-BUT-DISABLED day-1 — enable after reviewing first manual run.
# Kill switch: launchctl setenv CAREER_OPS_HEALTH_ENABLED false
#
# Born 2026-05-25 via /anthropic-skills:prompt-optimizer interview chain.
# Design doc: data/agent-spec-career-ops-health-2026-05-25.md
CAREER_OPS_HEALTH_ENABLED=true
# Daily spend ceiling. Default $20 matches regression-guard. --deploy-invoke
# from /deploy-verify auto-passes --budget 40 (2x default per Q9 locked).
CAREER_OPS_HEALTH_DAILY_USD=20
# Synthesis model. Sonnet 4.6 per Q13 locked decision — balanced cost/capability
# for cross-category correlation. Override to claude-opus-4-7 for harder cases.
CAREER_OPS_HEALTH_MODEL=claude-sonnet-4-6
# Set to "1" to stream operational log to stderr (useful for first-run debug).
# CAREER_OPS_HEALTH_VERBOSE=1

# ── /deploy-verify cost overrides (2026-05-25) ──────────────────────────────
# Per-deploy budget overrides for the 9-phase deploy procedure. Defaults are
# 2x the individual agent caps per Q9 locked decision (Aggressive 2x for
# critical deploys, ~$360 max total).
#
# Skill: /deploy-verify — invokes the full Phase 1-9 flow.
# Inline prompt: data/deploy-verify-prompt-2026-05-25.md
DEPLOY_VERIFY_REGRESSION_BUDGET_USD=20
DEPLOY_VERIFY_BUG_RESOLVER_BUDGET_USD=50
# Auto-merge bug-resolver DRAFT PRs that pass CI green AND do not touch
# sensitive paths (cv.md, data/applications.md, data/hm-intel/,
# data/apply-pack[s]/, data/second-brain-extracted/, *.env, etc).
# Set to "false" to surface every PR for manual review (matches the
# bug-resolver agent's default never-auto-merge invariant outside /deploy-verify).
# Per Q2 locked decision: aggressive auto-merge enabled for the deploy flow.
DEPLOY_VERIFY_AUTO_MERGE_DRAFT_PRS=true

# ── hiring-manager-research agent (full-spec, 2026-05-25) ───────────────────
# Replaces the previously-aspirational scripts/hiring-manager-research.mjs
# with a real council-of-7 + dealbreaker pipeline. Outputs the full ledger +
# adjudicated shape persisted to data/hm-intel/<slug>.json; lib/hm-intel-
# adapter.mjs preserves backward compatibility with every existing consumer.
#
# Cost envelope per Mitchell's locked decisions (interview chain 2026-05-25):
#   HM_INTEL_PER_ROW_CAP_USD          $50  hard cap per row (passed to callCouncil.opts.maxCostUsd)
#   HM_INTEL_MONTHLY_SOFT_ALERT_USD   $500 soft alert (Telegram + terminal, writes data/hm-intel-soft-alert-<YYYY-MM>.json)
#   HM_INTEL_MONTHLY_HARD_CAP_USD     $1000 hard refusal — script will not start a new row if monthly_spend + $50_estimate > $1000
#   HM_INTEL_CACHE_TTL_DAYS           30 days. --force ignores the TTL.
#   HM_INTEL_MONTHLY_TOP_N            5 — number of top active rows the monthly cron walks
#
# Plist: com.mitchell.career-ops.hm-intel-monthly — 1st of month at 02:00 PT.
# LOADED-BUT-DISABLED day-1 — enable AFTER reviewing first manual --dry-run.
# Bootstrap + enable:
#   launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.mitchell.career-ops.hm-intel-monthly.plist
#   launchctl enable gui/$(id -u)/com.mitchell.career-ops.hm-intel-monthly
HM_INTEL_PER_ROW_CAP_USD=50
HM_INTEL_MONTHLY_SOFT_ALERT_USD=500
HM_INTEL_MONTHLY_HARD_CAP_USD=1000
HM_INTEL_CACHE_TTL_DAYS=30
HM_INTEL_MONTHLY_TOP_N=5

# ── lib/council.mjs cost-distribution Part 2 (2026-05-25) ───────────────────
# Per-vendor MONTHLY spend caps used by checkVendorCap() before every council
# call. Sum is computed over the trailing 30 days from data/polish-cost-
# trace-<YYYY-MM-DD>.json (vendor-family aggregated by `provider:model` prefix).
#
# Set to 0 to disable cap-checking for that vendor entirely. Otherwise, any
# call whose (monthly_spend + estimated_call_cost) exceeds the cap is refused
# with:
#   COUNCIL_CAP_REACHED: vendor=<v> month=$<n> cap=$<c> — set
#   COUNCIL_<V>_MONTHLY_CAP_USD higher if intentional
#
# Defaults reflect the post-routing-matrix envelope (data/api-cost-audit-
# 2026-05-24.md Part 3 + service-capability-matrix). Anthropic is highest
# because Sonnet 4.6 is the implicit default + Opus 4.7 covers voice_match_
# writing / strategic_reasoning / code_refactor_multifile archetypes.
COUNCIL_ANTHROPIC_MONTHLY_CAP_USD=400
COUNCIL_OPENAI_MONTHLY_CAP_USD=70
COUNCIL_XAI_MONTHLY_CAP_USD=50
COUNCIL_PERPLEXITY_MONTHLY_CAP_USD=50
COUNCIL_GOOGLE_MONTHLY_CAP_USD=50

# ── Tier-0 free-tier Gemini cascade (conversational_chat archetype) ─────────
# Optional. If set, the `google:gemini-2.5-flash` slot in PROVIDERS tries this
# key first (free tier: 15 RPM / 1M TPM / 1500 RPD per Google AI Studio). On
# 429 or 403, falls through to the paid GEMINI_API_KEY above. Used by the
# conversational_chat routing archetype to avoid the paid-tier when free
# quota is available.
#
# Get a free key at https://aistudio.google.com/apikey (no billing required).
# GEMINI_FREE_API_KEY=your_free_tier_gemini_key_here

# ── Process All cap + audit log (2026-05-26) ────────────────────────────────
# PER_RUN_CAP_PROCESS_ALL_USD — per-run cap for /api/pipeline/process-all.
# Raised from $250 → $1000 on 2026-05-26 after the 3-tier modal made Tier 3
# (~$600) a routine choice. Force-override checkbox in the cost modal bypasses
# this; the audit log below records every spawn over the original $250
# threshold regardless of force. Clamp range [0, $10K].
PER_RUN_CAP_PROCESS_ALL_USD=1000

# PROCESS_ALL_AUDIT_THRESHOLD_USD — append-only audit log threshold. Every
# Process All spawn whose cost estimate exceeds this gets recorded to
# data/process-all-audit.jsonl with full tier + cost + force + companies
# context. Defaults to the pre-2026-05-26 cap value so every non-trivial
# spend run is reviewable. Audit write failures never block the spawn.
PROCESS_ALL_AUDIT_THRESHOLD_USD=250

# ── Triage provider routing (2026-05-26) ────────────────────────────────────
# TRIAGE_PROVIDER_PRIORITY — comma-separated fallback chain for STANDARD-tier
# triage (Tier 1, no --use-sonnet-jd flag). Wired providers: local (Ollama),
# anthropic (Haiku), gemini (Flash), xai (Grok-4-fast-reasoning), openai
# (gpt-5). First provider that returns a parseable result wins; on error or
# null score, the loop falls through to the next entry. Default unchanged
# since prior versions.
# TRIAGE_PROVIDER_PRIORITY=local,anthropic,gemini

# TRIAGE_PROVIDER_PRIORITY_PREMIUM — comma-separated fallback chain for
# PREMIUM-tier triage (Tier 2/3, with --use-sonnet-jd). Same provider set.
# Default 'gemini,xai' as of 2026-05-26 — Mitchell's locked decision: no
# Anthropic on the premium path (he's over the monthly cap). xai
# (Grok-4-fast-reasoning, ~$3/1M tokens blended) is the first fallback when
# Gemini errors. openai (gpt-5, ~$20/1M) is wired but kept off the default
# chain because cost would balloon ~6x if it became the primary fallback —
# opt in by setting TRIAGE_PROVIDER_PRIORITY_PREMIUM=gemini,xai,openai.
# To re-add Anthropic if cap is later cleared: =gemini,xai,anthropic.
# TRIAGE_PROVIDER_PRIORITY_PREMIUM=gemini,xai

# ── Discard-aware pre-triage gate (2026-05-26) ──────────────────────────────
# Three-tier gate that runs BEFORE any LLM call in triage.mjs::quickScoreRouted.
# Closes the loop on auto-re-ingest of previously-discarded roles (canonical
# incident: Anthropic Developer Education Lead, discarded 3x across rows
# 2068/47/2530 over 7 days). Spec: .claude/audit/discard-gate-spec-2026-05-26/notes.md
#
# Tier 1: exact-match on canonical (company, role) key → $0
# Tier 2: Sorensen-Dice fuzzy bigram (same company, fuzzy role) → $0
# Tier 3: GPT-5 adjudication via lib/council.mjs::callCouncil → ~$0.02/call

# Kill switch. Default 'false' for phased rollout per spec § 13. Set to 'true'
# after reviewing first audit-log run. When 'false', gate still writes audit
# entries (bypassed='disabled') so the would-have-skipped rate can be measured
# pre-rollout.
DISCARD_GATE_ENABLED=false

# How many days of prior discards count for Tier 1 + 2 matching. Older
# discards ignored (v1.0). Future enhancement: stale-but-distinct surfacing.
DISCARD_COOLDOWN_DAYS=90

# Daily spend cap on the Tier 3 GPT-5 adjudication call. Sums from
# data/discard-gate-spend.jsonl. On exhaustion, fuzzy hits → 'advance-flagged'
# (with prompt injection) instead of GPT-5 escalation.
DISCARD_GATE_GPT5_BUDGET_USD=5

# Sorensen-Dice bigram threshold for Tier 2. Below = no fuzzy match (advance);
# at-or-above = escalate to Tier 3 (or advance-flagged when Tier 3 disabled).
# Tune from production data after first 100 calls.
# DISCARD_GATE_TIER3_FUZZY_DICE_THRESHOLD=0.80

# GPT-5 self-reported confidence threshold for skip-gpt5 verdict. Below
# (or verdict=advance) → advance-flagged.
# DISCARD_GATE_TIER3_CONFIDENCE_THRESHOLD=0.80

# Per-call timeout for the GPT-5 adjudication call (ms). Capped at 60000.
# DISCARD_GATE_TIER3_TIMEOUT_MS=30000

# Test seam — path to a JSON fixture used in place of the real GPT-5 call.
# Honored regardless of NODE_ENV. Used by tests/discard-gate.test.mjs.
# DISCARD_GATE_TIER3_MOCK=/tmp/fixture.json
