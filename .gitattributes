# Git attributes for career-ops
# Merge drivers registered in .git/config via scripts/install-merge-drivers.sh

# Append-only JSONL ledgers — union-merge by id, latest timestamp wins on collision.
# Prevents "competing-bug-entry" class of conflict when parallel agents both write
# to the same JSONL at the same time.
# Driver: scripts/jsonl-merge-driver.mjs
data/bug-ledger.jsonl merge=jsonl-union
data/regression-bug-queue.jsonl merge=jsonl-union
data/v2-fix-log.jsonl merge=jsonl-union
data/v2-rollback-counter.jsonl merge=jsonl-union
# Persona-system ledgers (added 2026-05-28 with persona-system Wave 1).
# Multiple Wave 2 wire-ins (/deploy-verify Phase 3.5, /bug-resolver verify,
# /omega-steward Phase 4, /council --persona) write concurrently to the
# findings ledger; spend ledger is appended by every persona invocation.
# Both gitignored (see .gitignore) — driver here is defense-in-depth in case
# a future flow tracks them.
data/persona-findings.jsonl merge=jsonl-union
data/persona-review-spend.jsonl merge=jsonl-union
