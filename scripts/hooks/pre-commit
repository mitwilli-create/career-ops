#!/usr/bin/env bash
# scripts/hooks/pre-commit — reserved for index/diff checks that don't need
# the commit message.
#
# The UI-Change Verification audit-ref check that previously lived here was
# moved to scripts/hooks/commit-msg on 2026-05-20 (P3.23 iter5) because
# pre-commit cannot read the in-progress commit message — git writes
# .git/COMMIT_EDITMSG AFTER pre-commit fires, so the file holds the previous
# commit's message at pre-commit time, producing false positives + false
# negatives. See:
#   data/bug-reports/pre-commit-hook-stale-message-2026-05-20.md
#
# This file remains in place so future pre-commit-stage checks (e.g., linting,
# test gating, format enforcement on the staged diff) can be added here
# without re-creating the file. Install both hooks together via
# scripts/install-hooks.sh.
#
# Currently a no-op — exits 0 unconditionally.

set -euo pipefail

exit 0
