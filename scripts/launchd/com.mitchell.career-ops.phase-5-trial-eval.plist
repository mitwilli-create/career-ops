  Phase 5 ledger-summary-injection hook 4-week trial.

  Trial start: 2026-05-25 (PR #211 merge)
  Trial end / eval fire: 2026-06-22 09:00 PT

  Output: data/phase-5-trial-eval-<DATE>.md

  Belt-and-suspenders partner: /schedule remote agent fires the same day
  (Claude-native cron). Either trigger generates the eval; Mitchell reviews.

  After the eval fires on 2026-06-22, this plist can be safely unloaded +
  removed. The script is idempotent so accidental re-runs are no-ops.

  Per CLAUDE.md § Tahoe launchd KeepAlive bug — logs MUST live outside
  ~/Documents/ to avoid the sandbox issue.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mitchell.career-ops.phase-5-trial-eval</string>

      <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>export NVM_DIR=&quot;$HOME/.nvm&quot;; [ -s &quot;$NVM_DIR/nvm.sh&quot; ] &amp;&amp; . &quot;$NVM_DIR/nvm.sh&quot;; exec node &apos;/Users/mitchellwilliams/Documents/career-ops/scripts/launchd-wrapper.mjs&apos; &apos;--label=com.mitchell.career-ops.phase-5-trial-eval&apos; &apos;--max-retries=0&apos; &apos;--retry-backoff-sec=60&apos; &apos;--&apos; &apos;node&apos; &apos;/Users/mitchellwilliams/Documents/career-ops/scripts/agents/phase-5-trial-eval.mjs&apos; &apos;--check&apos;</string>
    </array>

  <key>WorkingDirectory</key>
  <string>/Users/mitchellwilliams/Documents/career-ops</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Month</key>
    <integer>6</integer>
    <key>Day</key>
