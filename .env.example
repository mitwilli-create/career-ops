# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── Gemini Integration (Issue #344) ─────────────────────────────────────────
# Required for: node gemini-eval.mjs "JD text here"
# Free API key: https://aistudio.google.com/apikey
# Free tier: 15 RPM / 1M tokens/day with gemini-2.0-flash (no billing needed)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Override default Gemini model ───────────────────────────────────
# Default: gemini-2.0-flash (free-tier, fast)
# Alternatives: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-thinking-exp
# GEMINI_MODEL=gemini-2.0-flash

# ── Heartbeat evening digest gate (Phase D, 2026-05-19) ─────────────────────
# Set to false to kill the evening email without uninstalling the launchd plist.
# Default when unset: true (enabled). --preview still works when set to false.
HEARTBEAT_EVENING_ENABLED=true

# ── G38 detector portfolio (2026-05-24) ─────────────────────────────────────
# Per-detector + global disable flags for the AI-detection layer
# (lib/ai-detection-gate.mjs). Preserves API keys for future re-enabling.
#
# Why this exists: data/detector-recalibration-audit-2026-05-23.md confirmed
# all 3 detectors return prob=1.0 on BOTH Mitchell's writing AND AI decoys —
# structural saturation, not adapter bugs. Layer 2 voice-rules carries the
# polish-loop gate per Closure 09 Part 5 fix. Paying for API calls the L1
# gate explicitly ignores is waste.
#
# Mitchell's locked 2026-05-24 decision: KEEP GPTZero (industry-standard
# for recruiter screening per SHRM 2026 + GPTZero's own "#1 AI Detector
# for Recruiters" positioning), PAUSE Originality (SEO/publishing focus,
# not recruiting) + Pangram (newer, less ATS-integrated). Polish-loop's new
# detection-revision sub-loop (lib/polish-loop.mjs G38 2026-05-24 block)
# iterates against GPTZero only with threshold <0.5 = "human-likely".
#
# Set value to "1" to disable. Re-enable individually as vendors improve.
# AI_DETECTION_DISABLED=1     # global kill — disables all 3 regardless of per-detector flags
# GPTZERO_DISABLED=1          # disable GPTZero only (current state: ENABLED)
ORIGINALITY_DISABLED=1        # disabled per 2026-05-24 G38 portfolio decision
PANGRAM_DISABLED=1            # disabled per 2026-05-24 G38 portfolio decision

# ── Batch cancellation timeout (P0.7, 2026-05-20) ──────────────────────────
# Graceful-cancel window for an in-flight batch before SIGKILL fires. Must be
# >= the AbortSignal.timeout in lib/anthropic-batch-helper.mjs (currently
# 120000ms / 120s). 125000ms = 5s safety margin over that.
# Default when unset: 125000.
# See AGENTS.md "Batch lifecycle" section + data/p07-batch-actions-ux-research-
# 2026-05-20.md for the convergence rationale.
BATCH_CANCEL_TIMEOUT_MS=125000

# ── Cost-stratified cancel warning threshold (P0.7 v2, 2026-05-20) ─────────
# Spend amount above which the "Cancel batch" button opens a single-confirm
# dialog ("$X spent on this batch — cancel anyway?") before SIGTERM. Below
# this, cancel is instant + uses the disabled "Stopping…" button state.
# Default when unset: 10 (USD). v2 work — see data/decisions-pending-2026-05-
# 20.md § "P0.7 v2 — cost-stratified cancel UX" for the 30-line sketch.
BATCH_CANCEL_WARN_THRESHOLD_USD=10

# ── Dashboard build-weight gate (P2.16, 2026-05-20) ─────────────────────────
# Soft and hard ceilings on the minified dashboard/index.html size. Catches
# the inline-payload-bloat bug class (~/.claude/knowledge/brain/bug-class-
# catalog.md § inline-payload-bloat) — when contacts / pill-data / wave-cb
# payloads accidentally get baked into the outer HTML instead of served from
# /data, the dashboard balloons fast. Soft over WARN: console.warn + continue.
# Hard over FAIL: process.exit(1).
# Defaults when unset: 12 MB warn / 15 MB fail (current build ~7.4 MB).
# Bypass entirely with DASHBOARD_SKIP_WEIGHT_GATE=1 (emergency only).
DASHBOARD_WEIGHT_WARN_BYTES=12582912
DASHBOARD_WEIGHT_FAIL_BYTES=15728640

# ── Polish convergence-runaway caps (2026-05-24) ────────────────────────────
# Per-artifact hard cap on TOTAL polish rounds across outer attempts. Pre-fix,
# lib/polish-loop.mjs could run maxRounds=6 INNER × outerRetries=3 = 18 rounds
# when the adversarial gate kept hedging passes:false with zero blocking
# findings. Canonical incident — 2026-05-24 PID 45655 on row #48 (Anthropic
# Engineering Editorial Lead): 82 min wall clock, $8.27 spent, never
# converged, process killed without writing polish-orchestrator-summary.json.
#
# When the cap is hit before convergence, the artifact is marked
# abandoned: true + abandon_reason: 'max-rounds-exceeded' and the loop exits.
# Default 6 (matches the prior per-outer cap, but applied across the full
# chain → at most ~$3-4 spend per artifact under typical Round 1-5 cost
# profile). Safety clamp [1, 30]. Override via CLI --max-rounds <N>.
POLISH_MAX_ROUNDS=6

# Soft cost-warn threshold below the hard POLISH_COST_CAP_USD=500. Two
# behaviors:
#   - Per-artifact (lib/polish-loop.mjs): NDJSON WARN line to stderr every
#     round after total artifact cost crosses this threshold. Does NOT block
#     the running artifact.
#   - Per-pack (scripts/agents/apply-pack-polish.mjs): force-abandons any
#     artifacts that have not started yet, with abandon_reason: 'cost-warn-
#     threshold'. Already-running artifacts complete normally.
# Default $5. Override via CLI --cost-warn-usd <N>.
POLISH_COST_WARN_USD=5

# ── Other integrations (add your own below) ──────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_key_here   # For Claude-based workflows
# OPENAI_API_KEY=your_openai_key_here          # Future OpenAI integration

# ── AI Detection Gate (lib/ai-detection-gate.mjs) ───────────────────────────
# Three-detector ensemble: GPTZero + Originality.AI + Pangram (third detector,
# selected by council + dealbreaker adjudication 2026-05-19).
# If a key is missing, that detector is skipped (not blocking).
#
# GPTZero: https://gptzero.me/api — ~$0.01/call
# GPTZERO_API_KEY=
#
# Originality.AI: https://originality.ai/api — ~$0.01/call
# ORIGINALITY_API_KEY=
#
# Pangram: https://www.pangram.com/solutions/api — ~$0.02/call, $20/mo base
# UChicago BFI study (Aug 2025): lowest FPR of any tested detector (0.004%)
# Dealbreaker-selected over Sapling (28-95% FPR) and Copyleaks (5-6% FPR)
# PANGRAM_API_KEY=

# ── Drive integration (Cluster E3, 2026-05-21) ──────────────────────────────
# OAuth client created in Google Cloud Console → APIs & Services → Credentials.
# Required scope: https://www.googleapis.com/auth/drive.file (drive.file is the
# narrowest scope that supports the apply-pack push/pull lifecycle).
# Run scripts/setup-drive-auth.mjs to populate GOOGLE_DRIVE_REFRESH_TOKEN
# + flip DRIVE_SYNC_ENABLED=true.
DRIVE_SYNC_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=your_oauth_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=

# ── regression-guard agent (2026-05-23) ─────────────────────────────────────
# Aggressive regression detection across 8 types. Daily 06:00 PT scheduled
# at v1.0 — Q3 lib-split sprint (2026-05-23 evening) moved to WEEKLY MONDAYS
# for the 4-week calibration window (2026-05-25 → 2026-06-22), then flip back
# to daily. Loaded-but-DISABLED day-1 awaiting trial-run review.
# Spec: /Users/mitchellwilliams/.claude/agents/runs/dealbreaker-final-20260523-132911-regression-agent-delta.md
# Mitchell's locked overrides of the dealbreaker numbers: $20 daily cap, NO
# hard per-call sub-cap, SOFT $5/call warning only.
REGRESSION_GUARD_ENABLED=true
REGRESSION_GUARD_AUTO_ACTION=false
REGRESSION_GUARD_DAILY_USD=20
REGRESSION_GUARD_PER_CALL_WARN_USD=5
REGRESSION_GUARD_CANARY_FAIL_SHUT=true
REGRESSION_GUARD_SILENT_PERIOD_DAYS_BY_TYPE=code:7,closure:7,memory:7,data:7,ui:7,pipeline:14,behavioral:14,performance:14
REGRESSION_GUARD_BASELINE_EXPIRY_DAYS=30
REGRESSION_GUARD_SELF_THROTTLE_THRESHOLD=8
# Feature flag for Vector 2 transcript baseline — keep OFF for first 30 days,
# flip after baseline-build review per dealbreaker § Audit Item 3.
REGRESSION_GUARD_TRANSCRIPT_BASELINE_ENABLED=false
REGRESSION_GUARD_CROSS_SESSION_CADENCE=daily
# Gemini 3.1 Pro is still in preview as of May 2026; GA migration may require
# code update per known-limitations. Defaults to preview.
REGRESSION_GUARD_GEMINI_TIER=preview
# Separate budget for --deep forensic mode (Opus 4.7 + Gemini 3.1 Pro + Sonnet 4.6).
# Q2 sprint 2026-05-23 live-validated the v1.1 multi-deep + Sonnet 4.6 path
# against real sessions at $0.0012 total spend (well under cap). The Gemini
# 3.1 Pro Preview model returned HTTP 404 from the v1beta endpoint — fallback
# to Sonnet now fires automatically on 404-model-not-found in addition to
# 5xx/timeout. See .claude/audit/regression-guard-tune-2026-05-23/deep-validation.md.
REGRESSION_GUARD_DEEP_BUDGET_USD=20

# ── popout-grounding (2026-05-23) ───────────────────────────────────────────
# Rollback gate for lib/ground-prompt.mjs — the RAG primitive that grounds
# the 4 drawer popouts (alignment / interview-likelihood / hm-chance /
# team-health) in Mitchell's personality corpus + profile.
#
# Default = "1" (grounded). Flip to "0" for instant revert to v0 generic
# prompt shapes — no code change needed, takes effect on next popout call.
#
# Locked decision #6 (popout-grounding /feedback 2026-05-23):
# rollback via env-flag is the required safety lock.
STRATEGY_CEILING_GROUNDED_MODE=1
# Opt-in Q3 Layer-3 LLM voice classifier on cache writes. Default off so
# popouts don't pay the ~$0.005 Haiku classifier call without explicit
# consent. Flip to "1" to attach voice_score telemetry to written cache
# entries (best-effort; classifier failures never block result).
STRATEGY_CEILING_VOICE_CLASSIFIER=0

# ── bug-resolver (2026-05-23) ────────────────────────────────────────────────
# 7-phase LLM pipeline: audit (Gemini) → research (Gemini) → adjudicate (Grok-4)
# → action_plan (Grok-4) → implement (GPT-5) → verify (Gemini) → harden (Gemini).
# Plist: com.mitchell.career-ops.bug-resolver — Mon/Thu 02:00 PT.
# LOADED-BUT-DISABLED day-1 — enable after reviewing trial run decision doc.
# Kill switch: launchctl setenv BUG_RESOLVER_ENABLED false
BUG_RESOLVER_ENABLED=true
# Daily spend ceiling across all bugs in a single run.
BUG_RESOLVER_DAILY_USD=150
# Per-bug spend ceiling (pipeline aborts if a single bug exceeds this).
BUG_RESOLVER_PER_BUG_CAP=30
# Max bugs processed per launchd run (sorted CRIT → HIGH → MED → LOW).
BUG_RESOLVER_MAX_BUGS_PER_RUN=5
# Per-vendor kill switches — set to "true" to disable a vendor for all phases.
# Circuit-breaker auto-fires after 3 consecutive 5xx/timeout failures.
BUG_RESOLVER_VENDOR_DISABLED_GEMINI=false
BUG_RESOLVER_VENDOR_DISABLED_GROK4=false
BUG_RESOLVER_VENDOR_DISABLED_GPT5=false
