      "$comment": "Council Decision C — apply this to <h2> emissions in the heartbeat MJML template.",
      "font_size": "16px",
      "font_weight": "700",
      "letter_spacing": "-0.3px",
      "text_transform": "none",
      "line_height": "1.3",
      "margin": "22px 0 10px",
      "border_left": "none",
      "color_token": "h2_color"
    },
    "h3_email_spec": {
      "$comment": "Council Decision C — apply this to <h3> emissions (demoted from old console-style 'section' treatment).",
      "font_size": "13px",
      "font_weight": "700",
      "letter_spacing": "0.04em",
      "text_transform": "uppercase",
      "line_height": "1.3",
      "margin": "16px 0 8px",
      "border_left": "3px solid",
      "border_left_color_token": "accent",
      "padding_left": "10px",
      "color_token": "h3_color"
    }
