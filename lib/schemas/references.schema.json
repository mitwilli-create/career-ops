{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careers-ops.com/schemas/references",
  "title": "References Artifact",
  "description": "Schema-typed references artifact emitted to apply-pack/<slug>/references.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "agent_name": {
      "type": "string",
      "const": "references"
    },
    "slug": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "company": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "framing": {
      "type": [
        "string",
        "null"
      ],
      "description": "Narrative framing for reference strategy (why these three)"
    },
    "ordering_rationale": {
      "type": [
        "string",
        "null"
      ],
      "description": "Why the references are ordered as listed"
    },
    "references": {
      "type": "array",
      "description": "Ordered list of recommended references",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "name"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "description": "Priority rank (1 = primary reference)"
          },
          "name": {
            "type": "string"
          },
          "role_at_org": {
            "type": [
              "string",
              "null"
            ]
          },
          "organization": {
            "type": [
              "string",
              "null"
            ]
          },
          "dates": {
            "type": [
              "string",
              "null"
            ],
            "description": "Dates of professional relationship, e.g. '2019-2022'"
          },
          "contact_method": {
            "type": [
              "string",
              "null"
            ],
            "description": "Email, LinkedIn, phone \u2014 how to reach them"
          },
          "cv_citation": {
            "type": [
              "string",
              "null"
            ],
            "description": "Source line in cv.md for this reference"
          },
          "jd_priority_mapping": {
            "type": [
              "string",
              "null"
            ],
            "description": "Which JD requirement this reference best addresses"
          },
          "can_substantiate": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Claims this reference can confirm"
          },
          "briefing_instruction": {
            "type": [
              "string",
              "null"
            ],
            "description": "What to brief this reference on before their call"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "agent_name",
    "slug",
    "generated_at",
    "references"
  ]
}
