<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        com.mitchell.career-ops.linkedin-readiness-monthly

        Closes audit-2026-05-23 LEDGER-021 (deferred from 2026-05-18 session
        be89f722 when the linkedin-readiness agent was created but the
        "schedule monthly re-run" portion of the original ask was dropped).

        Fires once a month on the 1st at 03:00 PT (Mitchell's local time).
        Invokes the /linkedin-readiness slash-command skill in a headless
        Claude Code session — the skill orchestrates the linkedin-readiness
        agent which calls council-of-models + dealbreaker as sub-agents.

        KeepAlive=false: one-shot per month, won't flap if it crashes —
        the next 1st-of-month picks it up.

        Cost expectation: per-run ~$20-50 depending on council fan-out
        depth + dealbreaker WebSearch budget. Run monthly is intentional
        — recruiter signal landscape moves on weekly+ timescales, not
        daily, so monthly cadence beats weekly on cost/signal ratio.

        Logs MUST live OUTSIDE ~/Documents/ — macOS Tahoe TCC blocks launchd
        from writing logs under Documents (silent EX_CONFIG=78). Pattern F
        / feedback_tahoe_sandbox_calendar_interval.md. Fixed 2026-05-22.

        Bootstrap (after merging to main):
            launchctl bootstrap gui/$(id -u) \
                /Users/mitchellwilliams/Documents/career-ops/scripts/launchd/com.mitchell.career-ops.linkedin-readiness-monthly.plist

        Unload:
            launchctl bootout gui/$(id -u)/com.mitchell.career-ops.linkedin-readiness-monthly

        Run on demand (for testing — skips Calendar gate):
            launchctl kickstart gui/$(id -u)/com.mitchell.career-ops.linkedin-readiness-monthly
    -->

    <key>Label</key>
    <string>com.mitchell.career-ops.linkedin-readiness-monthly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/mitchellwilliams/.nvm/versions/node/v24.14.0/bin/claude</string>
        <string>-p</string>
        <string>/linkedin-readiness</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mitchellwilliams/Documents/career-ops</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Log path MUST live outside ~/Documents/ — macOS Tahoe TCC blocks
         launchd from writing log files under Documents (silent EX_CONFIG=78).
         Pattern F / feedback_tahoe_sandbox_calendar_interval.md. -->
    <key>StandardOutPath</key>
    <string>/Users/mitchellwilliams/Library/Logs/career-ops/linkedin-readiness-monthly.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/mitchellwilliams/Library/Logs/career-ops/linkedin-readiness-monthly.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/mitchellwilliams/.nvm/versions/node/v24.14.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/mitchellwilliams</string>
    </dict>
</dict>
</plist>
